# ---------- Database (required) ----------
# PostgreSQL in every environment (see docker-compose.yml for local dev):
DATABASE_URL="postgresql://kapila:kapila_dev_pw@localhost:55432/kapilaghee"

# Production: point this at your real Postgres instance (Vercel Postgres, Neon,
# Supabase, RDS, etc.) — set this in your hosting provider's Environment Variables,
# never commit the real value.
# DATABASE_URL="postgresql://user:password@host:5432/kapilaghee?sslmode=require"

# ---------- Site URL (required for correct canonical/OG/sitemap URLs) ----------
# Used by app/layout.tsx, sitemap.ts, robots.ts, and structured data. Falls back to a
# placeholder kapiladairyfarm.com URL if unset — always set this explicitly in production
# to your real deployed URL (e.g. your Vercel domain or custom domain).
SITE_URL="http://localhost:3000"

# ---------- Initial admin account (seed script only — see prisma/seed.ts) ----------
# Only read once, when `npm run db:seed` creates the first AdminUser row (it won't
# overwrite an existing account with this email). Not read anywhere else at runtime.
# Change the password immediately after first login in a real deployment.
ADMIN_EMAIL="admin@kapiladairyfarm.com"
ADMIN_PASSWORD="change-this-before-seeding-production"

# ---------- Object storage (not yet used — see docs/architecture.md §8 and docs/deployment.md §4) ----------
# Admin file uploads currently save to the local filesystem (src/lib/storage.ts). This
# does NOT work on Vercel or any serverless host — the filesystem is ephemeral, so
# uploaded images/documents would disappear after the next deploy or cold start.
# Before real admin use on Vercel, swap storage.ts for an object-storage adapter (S3/R2)
# and wire it to variables like these:
# MEDIA_STORAGE_BUCKET=""
# MEDIA_STORAGE_ACCESS_KEY=""
# MEDIA_STORAGE_SECRET_KEY=""
