// Kapila Dairy Farm — Prisma schema
// Content model per docs/architecture.md §4.
//
// PostgreSQL in every environment, including local dev (via Docker — see
// docker-compose.yml). Earlier local development used SQLite as a zero-setup fallback
// when no Postgres instance was reachable; switched to Postgres everywhere once Docker
// became available, since Vercel's serverless functions can't use a local SQLite file
// (no persistent/shared filesystem) — this is now the same database engine in dev and prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ProductStatus {
  active
  inactive
}

enum VariantUnit {
  kg
  g
  ml
  l
}

enum PageKey {
  home
  story
  process
  quality
}

enum EnquiryStatus {
  new
  contacted
  closed
}

enum MediaCategory {
  product
  homepage
  story
  process
  quality
  other
}

// ---------- Core content ----------

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  status      ProductStatus   @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  variants    ProductVariant[]
  images      ProductMedia[]
  enquiries   Enquiry[]
}

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Float
  unit      VariantUnit
  status    ProductStatus @default(active)
  sortOrder Int           @default(0)

  // Phase 2 (e-commerce) fields — nullable, unused in Phase 1. See docs/future-ecommerce.md.
  price           Float?
  compareAtPrice  Float?
  sku             String?
  stock           Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  enquiries Enquiry[]
  images    ProductMedia[]

  @@index([productId])
}

model Media {
  id        String        @id @default(cuid())
  url       String
  altText   String?
  width     Int?
  height    Int?
  fileType  String
  fileSize  Int
  category  MediaCategory @default(other)
  status    ProductStatus @default(active)
  createdAt DateTime      @default(now())

  products        ProductMedia[]
  pageSections    PageSectionMedia[]
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  // Optional: ties this image to one specific pack size (e.g. the 5kg tin's own photo)
  // so the product gallery can swap images when a visitor selects a different size.
  // Null means "general" — shown regardless of which size is selected.
  variantId String?
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, mediaId])
}

model Document {
  id          String        @id @default(cuid())
  url         String
  label       String
  fileType    String
  fileSize    Int
  issuedBy    String?
  issuedDate  DateTime?
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now())

  pageSections PageSectionDocument[]
}

model PageSection {
  id        String        @id @default(cuid())
  page      PageKey
  key       String
  title     String?
  body      String?
  sortOrder Int           @default(0)
  status    ProductStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  media     PageSectionMedia[]
  documents PageSectionDocument[]

  @@unique([page, key])
}

model PageSectionMedia {
  id            String @id @default(cuid())
  pageSectionId String
  mediaId       String
  sortOrder     Int    @default(0)

  pageSection PageSection @relation(fields: [pageSectionId], references: [id], onDelete: Cascade)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([pageSectionId, mediaId])
}

model PageSectionDocument {
  id            String @id @default(cuid())
  pageSectionId String
  documentId    String
  sortOrder     Int    @default(0)

  pageSection PageSection @relation(fields: [pageSectionId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([pageSectionId, documentId])
}

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  status    ProductStatus @default(active)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BusinessSettings {
  id            String   @id @default(cuid())
  businessName  String
  address       String
  phone         String?
  whatsapp      String?
  email         String?
  instagram     String?
  facebook      String?
  googleMapsUrl String?
  updatedAt     DateTime @updatedAt
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  productId String?
  variantId String?
  status    EnquiryStatus @default(new)
  createdAt DateTime      @default(now())

  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
